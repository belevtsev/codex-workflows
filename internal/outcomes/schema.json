{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cw workflow outcome observations, version 1",
  "description": "Explicit local measurements. References are opaque and are never opened. Runtime validation additionally rejects control characters, surrounding whitespace and duplicate observation/task IDs, including conflicting repeated identities. Source fingerprints identify the task source snapshot; environments identify the measured runtime. The same actual Git revision may have different fingerprints as dirty or untracked files change; both observations are valid but their numeric comparison is excluded. A duration describes the observer's stated workload only. No time, token, quality, rate or cost measurement is inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "observations": {
      "type": "array", "minItems": 1, "maxItems": 5000,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "x-cw-limits": {
    "max_files": 100, "max_file_bytes": 2097152, "max_total_bytes": 16777216,
    "max_observations_total": 5000, "max_metric": 1000000000000,
    "text_lengths_are_utf8_byte_limits": true,
    "input_paths": "Regular files under explicit input-root; symlink inputs/directories and parent traversal are rejected."
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 256},
    "fingerprint": {"type": "string", "minLength": 1, "maxLength": 512},
    "reference": {"type": "string", "minLength": 1, "maxLength": 1024},
    "counter": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000},
    "number": {"type": "number", "minimum": 0, "maximum": 1000000000000},
    "project": {
      "type": "object", "additionalProperties": false, "required": ["kind", "identity"],
      "properties": {
        "kind": {"enum": ["go", "terraform", "roblox", "node", "python", "other"]},
        "identity": {"$ref": "#/$defs/text"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["fingerprint"],
      "description": "Fingerprint is required. Preserve the actual revision when known; omit or use null/empty revision for an unversioned project instead of inventing a revision label.",
      "properties": {
        "revision": {"anyOf": [{"$ref": "#/$defs/text"}, {"const": ""}, {"type": "null"}]},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "usage": {
      "type": ["object", "null"], "additionalProperties": false,
      "description": "Actual provider counters only. Omit or use null when unknown. Zero requires evidence of actual zero usage.",
      "properties": {
        "input_tokens": {"$ref": "#/$defs/counter"},
        "output_tokens": {"$ref": "#/$defs/counter"},
        "api_requests": {"$ref": "#/$defs/counter"}
      }
    },
    "quality": {
      "type": ["object", "null"], "additionalProperties": false,
      "description": "Only observed outcomes. incorrect_references must not exceed checked_references when both are known. Reference error rate needs both counts; defect miss rate needs both found and missed. rework is a count of observed rework events.",
      "properties": {
        "checked_references": {"$ref": "#/$defs/counter"},
        "incorrect_references": {"$ref": "#/$defs/counter"},
        "defects_found": {"$ref": "#/$defs/counter"},
        "defects_missed": {"$ref": "#/$defs/counter"},
        "rework": {"$ref": "#/$defs/counter"}
      }
    },
    "rates": {
      "type": "object", "additionalProperties": false,
      "required": ["input_per_million", "output_per_million", "api_request", "evidence"],
      "description": "All three reliable rates must be explicitly supplied with their source, including an explicit zero API request price when applicable. The tool performs no price lookup or independent provenance verification.",
      "properties": {
        "input_per_million": {"$ref": "#/$defs/number"},
        "output_per_million": {"$ref": "#/$defs/number"},
        "api_request": {"$ref": "#/$defs/number"},
        "evidence": {"$ref": "#/$defs/reference"}
      }
    },
    "cost": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["currency"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "amount": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000000},
        "evidence": {"type": "string", "maxLength": 1024},
        "rates": {"anyOf": [{"$ref": "#/$defs/rates"}, {"type": "null"}]}
      },
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["amount", "evidence"], "properties": {
          "amount": {"$ref": "#/$defs/number"}, "evidence": {"$ref": "#/$defs/reference"}, "rates": {"type": "null"}
        }},
        {"type": "object", "required": ["rates"], "properties": {
          "amount": {"type": "null"}, "evidence": {"const": ""}, "rates": {"$ref": "#/$defs/rates"}
        }}
      ]
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "case_id", "task_id", "project", "variant", "workload", "source", "environment", "evidence", "scope", "status"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/text"},
        "case_id": {"$ref": "#/$defs/text"},
        "task_id": {"$ref": "#/$defs/text"},
        "project": {"$ref": "#/$defs/project"},
        "variant": {"$ref": "#/$defs/text"},
        "workload": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/source"},
        "environment": {"$ref": "#/$defs/fingerprint"},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/reference"}},
        "scope": {"enum": ["synthetic_acceptance", "real_project_diagnostic", "real_project_productivity"]},
        "status": {"enum": ["succeeded", "failed"]},
        "duration_ms": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000000},
        "usage": {"$ref": "#/$defs/usage"},
        "cost": {"$ref": "#/$defs/cost"},
        "quality": {"$ref": "#/$defs/quality"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {
          "required": ["duration_ms"], "properties": {"duration_ms": {"$ref": "#/$defs/number"}}
        }},
        {"if": {"required": ["cost"], "properties": {"cost": {"type": "object", "required": ["rates"], "properties": {"rates": {"type": "object"}}}}}, "then": {
          "required": ["usage"], "properties": {"usage": {"type": "object", "required": ["input_tokens", "output_tokens", "api_requests"], "properties": {
            "input_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"}, "api_requests": {"type": "integer"}
          }}}
        }}
      ]
    }
  },
  "examples": [{
    "schema_version": 1,
    "observations": [{
      "observation_id": "go-diagnostic-baseline-1",
      "case_id": "go-diagnostic-1",
      "task_id": "go-diagnostic-baseline-execution-1",
      "project": {"kind": "go", "identity": "local-project-alias"},
      "variant": "baseline",
      "workload": "bounded-context-command-invocation",
      "source": {"revision": "measured-project-revision", "fingerprint": "sha256:measured-task-source"},
      "environment": "measured-runtime-fingerprint",
      "evidence": ["local:invocation-observer-record"],
      "scope": "synthetic_acceptance",
      "status": "succeeded",
      "duration_ms": 12.5
    }]
  }]
}
