{
  "name": "archify",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "description": "JSON-IR diagram renderers (architecture / workflow / sequence / dataflow / lifecycle).",
  "license": "MIT",
  "bin": {
    "archify": "./bin/archify.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:brand-marks": "node scripts/generate-brand-marks.mjs",
    "check:brand-marks": "node scripts/generate-brand-marks.mjs --check",
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "test": "node --test test/portable-path.test.mjs test/path-semantics.test.mjs test/output-path.test.mjs test/finalize.test.mjs test/update-contract.test.mjs test/managed-distribution.test.mjs",
    "test:browser": "node --test test/finalize-browser.test.mjs",
    "render:examples": "node scripts/render-examples.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "simple-icons": "16.28.0"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  }
}
